{
  "manifest_version": 3,
  "name": "Project AI",
  "version": "0.1.0",
  "description": "Quét DOM và chèn mô tả giả",

  "permissions": [
    "activeTab",
    "tabs"
  ],

  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle","all_frames": true   
    }
  ]
}